{
  "name": "nido-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS infrastructure for Nido Rooms (CDK) and its API Lambda",
  "scripts": {
    "build:app": "cd .. && npm run build",
    "synth": "cdk synth",
    "deploy": "npm run build:app && cdk deploy",
    "destroy": "cdk destroy",
    "dev": "npm run build:app && node dev/server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1163.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/lib-dynamodb": "3.1163.0",
    "@aws-sdk/s3-presigned-post": "3.1163.0"
  },
  "devDependencies": {
    "aws-cdk": "2.1148.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.25.12"
  }
}
